{
  "$schema_version": "contentmd.ux-content-corpus-rights-policy/0.2.0",
  "default": {
    "allowed_uses": [
      "human_review",
      "metadata_indexing",
      "model_classification",
      "model_evaluation",
      "source_discovery"
    ],
    "authority_effect": "none",
    "benchmark_eligibility": false,
    "model_processing_eligibility": "classification_and_evaluation_with_explicit_run_authorization",
    "model_retention_eligibility": "transient_only",
    "prompt_eligibility": "never",
    "processing_authorization_required": true,
    "rights_status": "rights_unknown_evidence_only",
    "training_eligibility": "never"
  },
  "overrides": [
    {
      "allowed_uses": [
        "legal_review",
        "metadata_indexing"
      ],
      "model_processing_eligibility": "never",
      "model_retention_eligibility": "never",
      "product_rank": 114,
      "reason_code": "source_terms_flagged_in_corpus_index",
      "rights_status": "excluded_pending_legal_review"
    },
    {
      "allowed_uses": [
        "legal_review",
        "metadata_indexing"
      ],
      "model_processing_eligibility": "never",
      "model_retention_eligibility": "never",
      "product_rank": 115,
      "reason_code": "source_terms_flagged_in_corpus_index",
      "rights_status": "excluded_pending_legal_review"
    }
  ],
  "prohibited_until_separately_authorized": [
    "benchmark_scoring",
    "commercial_reuse",
    "fine_tuning",
    "model_prompt_grounding",
    "retrieval_augmented_generation",
    "training"
  ],
  "processing_boundary": "Model classification and evaluation may inspect a bounded source only for semantic labeling under an explicit run authorization. This does not authorize generative prompt grounding, retrieval reuse, training, publication, or product-policy decisions.",
  "quotation_review": {
    "rule": "Every verbatim span requires source-level rights and quotation review before reuse.",
    "status": "required"
  }
}
