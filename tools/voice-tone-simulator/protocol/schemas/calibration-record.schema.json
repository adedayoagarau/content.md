{
  "$id": "https://content.md.invalid/vt-sim/calibration-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calibration_id": {
      "minLength": 1,
      "title": "Calibration Id",
      "type": "string"
    },
    "calibration_kind": {
      "enum": [
        "case",
        "truth"
      ],
      "title": "Calibration Kind",
      "type": "string"
    },
    "case_ref": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Case Ref"
    },
    "implementation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Hash",
      "type": "string"
    },
    "input_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "observed_event_status": {
      "enum": [
        "not_observed",
        "observed",
        "abstained",
        "unsupported_scope",
        "invalid"
      ],
      "title": "Observed Event Status",
      "type": "string"
    },
    "observed_event_value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Event Value"
    },
    "prediction_status": {
      "enum": [
        "not_run",
        "predicted_uncalibrated",
        "predicted_calibrated_for_scope",
        "abstained",
        "unsupported_scope",
        "invalid"
      ],
      "title": "Prediction Status",
      "type": "string"
    },
    "prediction_value": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prediction Value"
    },
    "protocol_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Hash",
      "type": "string"
    },
    "record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Hash",
      "type": "string"
    },
    "record_hash_algorithm": {
      "const": "sha256",
      "title": "Record Hash Algorithm",
      "type": "string"
    },
    "record_ordinal": {
      "minimum": 0,
      "title": "Record Ordinal",
      "type": "integer"
    },
    "record_type": {
      "const": "CalibrationRecord",
      "title": "Record Type",
      "type": "string"
    },
    "runtime_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Manifest Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "vt-sim-calibration-record/0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "seal_state": {
      "enum": [
        "not_applicable",
        "sealed",
        "unsealed_for_evaluation"
      ],
      "title": "Seal State",
      "type": "string"
    },
    "sealed_p_star": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sealed P Star"
    },
    "sealed_pi": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sealed Pi"
    },
    "source_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Hash",
      "type": "string"
    },
    "stream_id": {
      "minLength": 1,
      "title": "Stream Id",
      "type": "string"
    }
  },
  "required": [
    "record_hash",
    "schema_version",
    "record_type",
    "protocol_hash",
    "implementation_hash",
    "runtime_manifest_hash",
    "source_manifest_hash",
    "stream_id",
    "record_ordinal",
    "input_refs",
    "record_hash_algorithm",
    "calibration_id",
    "calibration_kind",
    "case_ref",
    "prediction_status",
    "prediction_value",
    "observed_event_status",
    "observed_event_value",
    "sealed_pi",
    "sealed_p_star",
    "seal_state"
  ],
  "title": "CalibrationRecord",
  "type": "object"
}
