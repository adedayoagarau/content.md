{
  "$id": "https://content.md.invalid/vt-sim/assignment-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignment_id": {
      "minLength": 1,
      "title": "Assignment Id",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "nonstarted",
        "nonlocked",
        "abstained",
        "submitted",
        "invalidated"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "disposition_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Disposition Reason"
    },
    "eligible": {
      "title": "Eligible",
      "type": "boolean"
    },
    "implementation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Hash",
      "type": "string"
    },
    "input_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "protocol_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Hash",
      "type": "string"
    },
    "record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Hash",
      "type": "string"
    },
    "record_hash_algorithm": {
      "const": "sha256",
      "title": "Record Hash Algorithm",
      "type": "string"
    },
    "record_ordinal": {
      "minimum": 0,
      "title": "Record Ordinal",
      "type": "integer"
    },
    "record_type": {
      "const": "AssignmentDispositionRecord",
      "title": "Record Type",
      "type": "string"
    },
    "replicate_index": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Replicate Index",
      "type": "string"
    },
    "runtime_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Manifest Hash",
      "type": "string"
    },
    "scenario_parameter_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scenario Parameter Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "vt-sim-assignment-record/0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Hash",
      "type": "string"
    },
    "stream_id": {
      "minLength": 1,
      "title": "Stream Id",
      "type": "string"
    }
  },
  "required": [
    "record_hash",
    "schema_version",
    "record_type",
    "protocol_hash",
    "implementation_hash",
    "runtime_manifest_hash",
    "source_manifest_hash",
    "stream_id",
    "record_ordinal",
    "input_refs",
    "record_hash_algorithm",
    "assignment_id",
    "scenario_parameter_hash",
    "replicate_index",
    "disposition",
    "disposition_reason",
    "eligible"
  ],
  "title": "AssignmentDispositionRecord",
  "type": "object"
}
