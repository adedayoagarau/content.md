{
  "$id": "https://content.md.invalid/vt-sim/provenance-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_role": {
      "minLength": 1,
      "title": "Actor Role",
      "type": "string"
    },
    "capability_envelope": {
      "const": "offline_synthetic_only",
      "title": "Capability Envelope",
      "type": "string"
    },
    "data_class": {
      "const": "synthetic_only",
      "title": "Data Class",
      "type": "string"
    },
    "derivation_method_id": {
      "minLength": 1,
      "title": "Derivation Method Id",
      "type": "string"
    },
    "implementation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Hash",
      "type": "string"
    },
    "input_refs": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "parent_record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Parent Record Hash",
      "type": "string"
    },
    "protocol_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Hash",
      "type": "string"
    },
    "provenance_id": {
      "minLength": 1,
      "title": "Provenance Id",
      "type": "string"
    },
    "record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Hash",
      "type": "string"
    },
    "record_hash_algorithm": {
      "const": "sha256",
      "title": "Record Hash Algorithm",
      "type": "string"
    },
    "record_ordinal": {
      "minimum": 0,
      "title": "Record Ordinal",
      "type": "integer"
    },
    "record_type": {
      "const": "ProvenanceRecord",
      "title": "Record Type",
      "type": "string"
    },
    "recorded_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Recorded At",
      "type": "string"
    },
    "runtime_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Manifest Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "vt-sim-provenance-record/0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_coordinates": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Seed Coordinates",
      "type": "array"
    },
    "source_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Hash",
      "type": "string"
    },
    "stream_id": {
      "minLength": 1,
      "title": "Stream Id",
      "type": "string"
    }
  },
  "required": [
    "record_hash",
    "schema_version",
    "record_type",
    "protocol_hash",
    "implementation_hash",
    "runtime_manifest_hash",
    "source_manifest_hash",
    "stream_id",
    "record_ordinal",
    "input_refs",
    "record_hash_algorithm",
    "provenance_id",
    "parent_record_hash",
    "derivation_method_id",
    "seed_coordinates",
    "recorded_at",
    "actor_role",
    "data_class",
    "capability_envelope"
  ],
  "title": "ProvenanceRecord",
  "type": "object"
}
