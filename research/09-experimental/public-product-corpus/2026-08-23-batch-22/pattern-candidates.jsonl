{"pattern_id":"pat-whiteboard-pricing-pages-tie-plan-value-to-shared-collaboration","description":"Whiteboard products explain plan value through collaboration capacity, board visibility, and export/share features so small teams can self-select without reading fine print first.","supporting_sources":["src-miro-pricing-22","src-miro-help-plans-22","src-miro-free-22"],"transfer_conditions":["whiteboarding and collaboration"],"counterexamples":["single-user drawing tools"],"failure_modes":["plan confusion","sharing confusion"],"non_transferable_details":["exact seat pricing"],"rights_boundary":"evidence only"}
{"pattern_id":"pat-site-builders-separate-site-plans-from-add-on-capabilities","description":"Site builders often split core site publishing from optional capabilities like analytics or localization so users can understand what is required to publish versus optimize.","supporting_sources":["src-webflow-pricing-22","src-webflow-blog-22","src-webflow-terms-22"],"transfer_conditions":["site building and hosting"],"counterexamples":["static brochure tools"],"failure_modes":["publish confusion","add-on confusion"],"non_transferable_details":["exact page-view pricing"],"rights_boundary":"evidence only"}
{"pattern_id":"pat-work-management-pricing-pages-highlight-enterprise-support-delivery","description":"Work-management pricing pages commonly surface support, uptime, and migration services alongside the plan table because operational confidence is part of the purchase decision.","supporting_sources":["src-asana-pricing-22","src-asana-starter-22","src-asana-premium-22"],"transfer_conditions":["work management"],"counterexamples":["personal to-do apps"],"failure_modes":["support confusion"],"non_transferable_details":["exact SLA terms"],"rights_boundary":"evidence only"}
{"pattern_id":"pat-database-workflow-pricing-relies-on-collaborator-and-permission-language","description":"Database and workflow products need clear collaborator-permission language so teams can reason about who is billed, who is read-only, and what actions stay free.","supporting_sources":["src-airtable-pricing-22","src-airtable-team-22","src-airtable-nonprofit-22"],"transfer_conditions":["database and workflow apps"],"counterexamples":["single-owner spreadsheets"],"failure_modes":["billing confusion","permission confusion"],"non_transferable_details":["exact collaborator rules"],"rights_boundary":"evidence only"}
