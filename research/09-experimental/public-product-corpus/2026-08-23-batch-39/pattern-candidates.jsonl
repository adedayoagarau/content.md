{"pattern_id":"pat-ai-service-pricing-pages-should-link-outcomes-to-value","description":"Customer service pricing pages should connect AI outcomes to the price so buyers can estimate value instead of just seat count.","supporting_sources":["src-intercom-pricing-39","src-intercom-home-39","src-intercom-fin-39"],"transfer_conditions":["customer service"],"counterexamples":["traditional ticketing tools"],"failure_modes":["outcome confusion","seat confusion"],"non_transferable_details":["exact outcome price"],"rights_boundary":"evidence only"}
{"pattern_id":"pat-file-platform-pricing-pages-should-highlight-free-account-scope","description":"File-sharing pricing pages should explain what the free tier includes and where paid plans begin.","supporting_sources":["src-dropbox-pricing-39","src-dropbox-home-39","src-dropbox-basic-39"],"transfer_conditions":["file storage and sharing"],"counterexamples":["local file explorers"],"failure_modes":["free-plan confusion","collaboration confusion"],"non_transferable_details":["exact storage allotments"],"rights_boundary":"evidence only"}
{"pattern_id":"pat-database-platform-pricing-pages-need-addon-language","description":"Database-platform pricing pages should explain add-ons such as portals and how they layer on top of the base plan.","supporting_sources":["src-airtable-pricing-39","src-airtable-home-39","src-airtable-portals-39"],"transfer_conditions":["fileless database"],"counterexamples":["single-sheet trackers"],"failure_modes":["addon confusion","tier confusion"],"non_transferable_details":["exact portal seat counts"],"rights_boundary":"evidence only"}
{"pattern_id":"pat-developer-pricing-pages-should-separate-ai-add-ons-from-core-hosting","description":"Developer platform pricing pages should separate the core platform from AI add-ons or compute metering so teams can estimate total cost.","supporting_sources":["src-github-pricing-39","src-github-home-39","src-github-copilot-39"],"transfer_conditions":["developer platform"],"counterexamples":["single-repo hosting tools"],"failure_modes":["add-on confusion","compute confusion"],"non_transferable_details":["exact hourly rates"],"rights_boundary":"evidence only"}
