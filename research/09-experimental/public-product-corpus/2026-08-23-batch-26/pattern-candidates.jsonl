{"pattern_id":"pat-education-plans-need-clear-team-and-classroom-explanations","description":"Collaboration tools with education offers need to explain how classroom eligibility maps to the standard collaboration product so schools know whether they are seeing a discount or a distinct plan.","supporting_sources":["src-miro-education-26","src-miro-pricing-26","src-miro-help-26"],"transfer_conditions":["whiteboarding and collaboration"],"counterexamples":["consumer sketch apps"],"failure_modes":["discount confusion","eligibility confusion"],"non_transferable_details":["exact school criteria"],"rights_boundary":"evidence only"}
{"pattern_id":"pat-nonprofit-pages-link-benefits-to-work-management-plans","description":"Work-management products often pair nonprofit discount pages with core plan features and support language so administrators can match mission-based eligibility to functional value.","supporting_sources":["src-asana-nonprofit-26","src-asana-pricing-26","src-asana-starter-26"],"transfer_conditions":["work management"],"counterexamples":["personal task lists"],"failure_modes":["discount confusion","support confusion"],"non_transferable_details":["exact discount percentage"],"rights_boundary":"evidence only"}
{"pattern_id":"pat-database-pricing-pages-explain-who-is-billed","description":"Database and workflow products need explicit billing rules because edit permissions, read-only access, and collaborator type can change who counts as a paid user.","supporting_sources":["src-airtable-pricing-26","src-airtable-team-26","src-airtable-nonprofit-26"],"transfer_conditions":["database and workflow apps"],"counterexamples":["single-user spreadsheets"],"failure_modes":["billing confusion","permission confusion"],"non_transferable_details":["exact collaborator charges"],"rights_boundary":"evidence only"}
{"pattern_id":"pat-site-builders-separate-free-creation-from-publishable-sites","description":"Site builders benefit from a homepage-plus-blog pattern that distinguishes free creation from paid site publishing and hosting requirements.","supporting_sources":["src-webflow-blog-26","src-webflow-pricing-26","src-webflow-terms-26"],"transfer_conditions":["site building and hosting"],"counterexamples":["static marketing pages"],"failure_modes":["publish confusion","hosting confusion"],"non_transferable_details":["exact bandwidth limits"],"rights_boundary":"evidence only"}
