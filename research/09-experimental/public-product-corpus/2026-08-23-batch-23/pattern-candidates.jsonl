{"pattern_id":"pat-storage-products-separate-free-entry-from-paid-team-sharing","description":"File-storage products typically explain the free account first and then clarify how business tiers expand sharing and team storage, which reduces upgrade ambiguity.","supporting_sources":["src-dropbox-home-23","src-dropbox-basic-23","src-dropbox-business-23"],"transfer_conditions":["file storage and sharing"],"counterexamples":["offline storage utilities"],"failure_modes":["storage confusion","team-sharing confusion"],"non_transferable_details":["exact storage caps"],"rights_boundary":"evidence only"}
{"pattern_id":"pat-content-management-vendors-highlight-business-security-and-bundles","description":"Content-management vendors use business-plan pages to connect collaboration, security, and admin controls so procurement can separate personal from business use.","supporting_sources":["src-box-pricing-23","src-box-home-23","src-box-personal-23"],"transfer_conditions":["content management"],"counterexamples":["simple document viewers"],"failure_modes":["security confusion","bundle confusion"],"non_transferable_details":["exact enterprise limits"],"rights_boundary":"evidence only"}
{"pattern_id":"pat-creative-suite-pages-need-clear-license-and-governance-terms","description":"Creative-suite pages benefit from explicit license and governance language because the same product may serve casual creators, business users, and government teams.","supporting_sources":["src-canva-home-23","src-canva-pro-23","src-canva-gov-23"],"transfer_conditions":["creative suite"],"counterexamples":["single-purpose design apps"],"failure_modes":["license confusion","governance confusion"],"non_transferable_details":["exact legal terms"],"rights_boundary":"evidence only"}
