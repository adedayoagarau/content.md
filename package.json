{
  "name": "contentmd-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "contentmd": "node packages/cli/dist/main.js",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run && pnpm test:node",
    "test:node": "node --test scripts/*.test.mjs packages/research/test/*.test.mjs",
    "test:watch": "vitest",
    "lint": "node scripts/check-package-boundaries.mjs && tsc -b tsconfig.json --pretty false",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "generate:learning-fixtures": "node --import tsx scripts/generate-learning-fixtures.mts",
    "verify:learning": "node scripts/verify-learning.mjs",
    "verify:runtime": "node scripts/verify-portable-runtime.mjs",
    "verify:repository-intelligence": "node scripts/verify-repository-intelligence.mjs",
    "verify:voice-research": "node scripts/verify-voice-tone-research.mjs",
    "build:distribution": "node scripts/build-contentmd-distribution.mjs",
    "test:distribution": "node scripts/test-contentmd-distribution.mjs",
    "verify:release": "node scripts/verify-contentmd-release.mjs"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
