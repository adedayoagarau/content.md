{
  "name": "contentmd-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "preinstall": "node scripts/verify-development-toolchain.mjs --install",
    "verify:toolchain": "node scripts/verify-development-toolchain.mjs",
    "build": "tsc -b tsconfig.json",
    "contentmd": "node packages/cli/dist/main.js",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "node scripts/run-vitest-release-gate.mjs && pnpm test:node",
    "test:node": "node --test scripts/*.test.mjs packages/research/test/*.test.mjs",
    "test:watch": "vitest",
    "lint": "node scripts/check-package-boundaries.mjs && tsc -b tsconfig.json --pretty false",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "generate:learning-fixtures": "node --import tsx scripts/generate-learning-fixtures.mts",
    "generate:learning-code-manifests": "node scripts/generate-learning-code-manifests.mjs",
    "verify:learning": "node scripts/verify-learning.mjs",
    "verify:runtime": "node scripts/verify-portable-runtime.mjs",
    "verify:repository-intelligence": "node scripts/verify-repository-intelligence.mjs",
    "verify:voice-research": "node scripts/verify-voice-tone-research.mjs",
    "generate:content-design-scenarios": "node scripts/generate-content-design-evaluation-scenarios.mjs",
    "prepare:content-design-review": "node scripts/prepare-content-design-review-sample.mjs",
    "prepare:content-design-challenge-reviews": "node scripts/prepare-authored-content-design-reviews.mjs",
    "prepare:content-design-calibration": "node scripts/prepare-content-design-review-sample.mjs --calibration-out docs/tests/fixtures/content-design-scenarios/calibration-cohort-500.json",
    "review:content-design-calibration": "node packages/cli/dist/main.js benchmark content-design --packet docs/tests/fixtures/content-design-scenarios/calibration-cohort-500.json --review-workbench",
    "reserve:content-design-evaluation": "node scripts/prepare-content-design-review-sample.mjs --reservation-out docs/tests/fixtures/content-design-scenarios/held-out-reservation-500.json",
    "qualify:content-design-review": "node scripts/qualify-content-design-review.mjs",
    "predict:content-design-scenarios": "node scripts/predict-content-design-scenarios.mjs",
    "verify:content-design-benchmark": "node scripts/verify-content-design-benchmark.mjs",
    "verify:content-design-challenges": "node scripts/verify-authored-content-design-challenges.mjs",
    "verify:security": "node scripts/verify-contentmd-security.mjs",
    "build:distribution": "node scripts/build-contentmd-distribution.mjs",
    "test:distribution": "node scripts/test-contentmd-distribution.mjs",
    "verify:release": "node scripts/verify-contentmd-release.mjs"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
