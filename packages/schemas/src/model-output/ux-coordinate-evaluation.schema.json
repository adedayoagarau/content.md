{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contentmd.ux-coordinate-evaluation-model-output/0.1.0",
  "type": "object",
  "properties": {
    "authority_effect": { "const": "none" },
    "model_processing_purpose": { "const": "evaluation_only" },
    "verdict": { "enum": ["pass", "revise", "abstain", "escalate"] },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "enum": [
              "evidence_relation",
              "requested_axis_coverage",
              "source_label_compatibility",
              "ontology_conformance",
              "internal_consistency",
              "uncertainty_is_honest"
            ]
          },
          "status": { "enum": ["pass", "fail", "unknown"] },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 500 },
            "minItems": 0,
            "maxItems": 500
          }
        },
        "required": ["criterion", "status", "rationale", "evidence_refs"],
        "additionalProperties": false
      },
      "minItems": 6,
      "maxItems": 6
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "axis": {
            "enum": [
              "work_intent",
              "journey",
              "state",
              "event_state",
              "message_purposes",
              "content_slot",
              "interaction_pattern",
              "action_family",
              "channel",
              "attention_mode",
              "task_structure",
              "state_cause",
              "content_scope",
              "reversibility",
              "conversation_state",
              "locale",
              "risk"
            ]
          },
          "status": { "enum": ["exact", "ambiguous", "unclassified"] },
          "values": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 200 },
            "minItems": 0,
            "maxItems": 32
          },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 500 },
            "minItems": 0,
            "maxItems": 500
          },
          "uncertainty": { "enum": ["none", "bounded", "material"] }
        },
        "required": ["axis", "status", "values", "rationale", "evidence_refs", "uncertainty"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 17
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 },
      "minItems": 0,
      "maxItems": 100
    },
    "authority_escalation_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "authority_effect",
    "model_processing_purpose",
    "verdict",
    "criteria",
    "corrections",
    "unresolved",
    "authority_escalation_reasons"
  ],
  "additionalProperties": false
}
