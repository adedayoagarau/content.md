{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content.md/schemas/ux-writing-intelligence-records/0.1.0",
  "title": "content.md deterministic UX-writing intelligence records",
  "oneOf": [
    { "$ref": "#/$defs/rulePackRecord" },
    { "$ref": "#/$defs/reviewReportRecord" },
    { "$ref": "#/$defs/repairBriefRecord" }
  ],
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "factValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "$ref": "#/$defs/strings" }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_path", "operator"],
      "properties": {
        "fact_path": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$" },
        "operator": { "enum": ["exists", "equals", "not_equals", "in", "contains", "matches"] },
        "value": { "$ref": "#/$defs/factValue" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "rule_version", "title", "classification", "dimension", "review_type", "applies_when", "assertion", "failure_status", "reason", "consequence", "repair", "required_fact_paths", "source_refs", "fixture_refs", "override_policy"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^uxw\\.[a-z0-9_.-]+$" },
        "rule_version": { "const": "0.1.0" },
        "title": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["hard", "advisory"] },
        "dimension": { "type": "string", "minLength": 1 },
        "review_type": { "enum": ["deterministic", "specialist", "research", "human_judgment", "preference"] },
        "applies_when": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "assertion": { "$ref": "#/$defs/condition" },
        "failure_status": { "enum": ["fail", "unknown"] },
        "reason": { "type": "string", "minLength": 1 },
        "consequence": { "type": "string", "minLength": 1 },
        "repair": { "type": "string", "minLength": 1 },
        "required_fact_paths": { "$ref": "#/$defs/nonEmptyStrings" },
        "source_refs": { "$ref": "#/$defs/nonEmptyStrings" },
        "fixture_refs": { "$ref": "#/$defs/nonEmptyStrings" },
        "override_policy": { "enum": ["core_immutable", "project_may_suppress_advisory"] }
      }
    },
    "rulePackRecord": {
      "allOf": [
        { "$ref": "https://content.md/schemas/base-record/0.1.0" },
        { "properties": { "schema_id": { "const": "contentmd.ux-writing-rule-pack" }, "payload": { "$ref": "#/$defs/rulePackPayload" } } }
      ]
    },
    "rulePackPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "pack_id", "pack_version", "layer", "status", "scope", "rules", "suppressed_rule_ids", "supersedes_pack_ref", "approval_refs", "authority_effect"],
      "properties": {
        "contract_version": { "const": "contentmd.ux-writing-rule-pack/0.1.0" },
        "pack_id": { "type": "string", "pattern": "^uxw-pack\\.[a-z0-9_.-]+$" },
        "pack_version": { "type": "integer", "minimum": 1 },
        "layer": { "enum": ["core", "project"] },
        "status": { "enum": ["proposed", "approved", "retired"] },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surfaces", "channels", "locales", "risk_levels"],
          "properties": {
            "surfaces": { "$ref": "#/$defs/strings" },
            "channels": { "$ref": "#/$defs/strings" },
            "locales": { "$ref": "#/$defs/strings" },
            "risk_levels": { "type": "array", "uniqueItems": true, "items": { "enum": ["low", "medium", "high", "critical"] } }
          }
        },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },
        "suppressed_rule_ids": { "$ref": "#/$defs/strings" },
        "supersedes_pack_ref": { "type": ["string", "null"] },
        "approval_refs": { "$ref": "#/$defs/strings" },
        "authority_effect": { "const": "none" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "rule_id", "classification", "dimension", "status", "review_type", "reason", "consequence", "repair", "evidence_refs"],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["hard", "advisory"] },
        "dimension": { "type": "string", "minLength": 1 },
        "status": { "enum": ["fail", "unknown"] },
        "review_type": { "enum": ["deterministic", "specialist", "research", "human_judgment", "preference"] },
        "reason": { "type": "string", "minLength": 1 },
        "consequence": { "type": "string", "minLength": 1 },
        "repair": { "type": "string", "minLength": 1 },
        "evidence_refs": { "$ref": "#/$defs/strings" }
      }
    },
    "reviewReportRecord": {
      "allOf": [
        { "$ref": "https://content.md/schemas/base-record/0.1.0" },
        { "properties": { "schema_id": { "const": "contentmd.ux-writing-review-report" }, "payload": { "$ref": "#/$defs/reviewReportPayload" } } }
      ]
    },
    "reviewReportPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "report_id", "request_ref", "target", "input_digest", "rule_pack_digests", "findings", "hard_plane_status", "advisory_status", "recommended_disposition", "repair_brief_ref", "authority_effect", "report_digest"],
      "properties": {
        "contract_version": { "const": "contentmd.ux-writing-review-report/0.1.0" },
        "report_id": { "type": "string", "pattern": "^uxwreview\\.[a-f0-9]{32}$" },
        "request_ref": { "type": "string", "minLength": 1 },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_artifact", "line", "column", "text"],
          "properties": {
            "source_artifact": { "type": "string", "minLength": 1 },
            "line": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer", "minimum": 1 },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        "input_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rule_pack_digests": { "$ref": "#/$defs/nonEmptyStrings" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "hard_plane_status": { "enum": ["pass", "fail", "unknown"] },
        "advisory_status": { "enum": ["pass", "findings_present", "not_evaluated"] },
        "recommended_disposition": { "enum": ["abstain", "escalate", "revise", "human_review", "bounded_approval", "reject"] },
        "repair_brief_ref": { "type": ["string", "null"] },
        "authority_effect": { "const": "none" },
        "report_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "repairBriefRecord": {
      "allOf": [
        { "$ref": "https://content.md/schemas/base-record/0.1.0" },
        { "properties": { "schema_id": { "const": "contentmd.ux-writing-repair-brief" }, "payload": { "$ref": "#/$defs/repairBriefPayload" } } }
      ]
    },
    "repairBriefPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "brief_id", "request_ref", "review_report_ref", "preserve", "must_change", "must_not_claim", "required_facts", "consequence", "recovery", "channel", "locale", "acceptance_criteria", "unresolved_questions", "authority_effect", "brief_digest"],
      "properties": {
        "contract_version": { "const": "contentmd.ux-writing-repair-brief/0.1.0" },
        "brief_id": { "type": "string", "pattern": "^uxwrepair\\.[a-f0-9]{32}$" },
        "request_ref": { "type": "string", "minLength": 1 },
        "review_report_ref": { "type": "string", "minLength": 1 },
        "preserve": { "$ref": "#/$defs/nonEmptyStrings" },
        "must_change": { "$ref": "#/$defs/nonEmptyStrings" },
        "must_not_claim": { "$ref": "#/$defs/strings" },
        "required_facts": { "$ref": "#/$defs/nonEmptyStrings" },
        "consequence": { "type": ["string", "null"] },
        "recovery": { "type": ["string", "null"] },
        "channel": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 1 },
        "acceptance_criteria": { "$ref": "#/$defs/nonEmptyStrings" },
        "unresolved_questions": { "$ref": "#/$defs/strings" },
        "authority_effect": { "const": "none" },
        "brief_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
